# Copy this file to .env and fill in your values.
# .env is gitignored and never committed.

# URL of this (main) repo — used by Killercoda's foreground.sh to clone
# task scripts at scenario start time. Must be public.
KUBE_DOJO_REPO_URL=https://github.com/your-org/kube-dojo

# Local path to your checked-out kube-dojo-scenarios repo.
# The generator writes scenario files here when KILLERCODA_SCENARIOS_DIR is set.
# If unset, scenarios are written to adapters/killercoda/scenarios/ in this repo.
KILLERCODA_SCENARIOS_DIR=/path/to/kube-dojo-scenarios
